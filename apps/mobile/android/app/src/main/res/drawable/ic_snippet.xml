<?xml version="1.0" encoding="utf-8"?>
<!-- 定型文一覧を示すアイコン（文章の入った紙）。
     フィルター行の表示切替トグルが「押すと定型文一覧に戻る」状態のときに使う。

     【tintを@color/keyboardAccentにする理由】
     トグルのアイコンは「押したら何が表示されるか」を示すため、ショートカット表示中にこの絵になる。
     絵だけでは今どちらを見ているのか分かりにくいので、ショートカット表示中であることを
     アクセント色で表す（定型文表示中のic_shortcutは既定の?attr/colorControlNormalのまま）。
     keyboardAccentはvalues-nightにも定義があり、ライト・ダークのどちらでも見える。

     【線だけの一覧アイコンにしなかった理由】
     右隣のソートアイコン（ic_sort）も横線の並びのため、紙の枠を持たせて区別している。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/keyboardAccent">
    <!-- 24dpの枠に対して少し内側（3〜21）へ収めている。
         ヘッダーのボタンは36dp・padding 8dp（描画領域20dp）でscaleType=centerのため、
         24dpいっぱいに描くと端が欠けるため -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19,3H5C3.9,3 3,3.9 3,5v14c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2V5C21,3.9 20.1,3 19,3zM14,17H7v-2h7V17zM17,13H7v-2h10V13zM17,9H7V7h10V9z"/>
</vector>
