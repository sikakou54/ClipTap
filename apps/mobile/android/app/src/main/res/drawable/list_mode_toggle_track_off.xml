<?xml version="1.0" encoding="utf-8"?>
<!-- 表示切替トグルのトラック（定型文を表示しているとき）

     角丸の半径はトラックの高さ32dpの半分にして、完全なピル形にする。
     色はヘッダーの他の副ボタンと同じ keyboardSecondaryButtonBackground を使い、
     values-night にも定義があるためライト・ダークのどちらでも背景から浮く。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/keyboardSecondaryButtonBackground" />
    <corners android:radius="16dp" />
</shape>
