<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="360dp"
    android:minHeight="360dp"
    android:maxHeight="360dp">

    <!-- メインビュー（リスト表示） -->
<LinearLayout
    android:id="@+id/mainView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 統合フィルターエリア（環境ドロップダウン + カテゴリドロップダウン + ソートボタン） -->
    <LinearLayout
        android:id="@+id/filterContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/transparent">

        <!-- 環境選択ドロップダウンボタン（左端、固定幅100dp） -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/profileChipGroup"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            app:singleSelection="true"
            app:chipSpacing="0dp" />

        <!-- カテゴリ選択ドロップダウンボタン（固定幅100dp） -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/categoryChipGroup"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            app:singleSelection="true"
            app:chipSpacing="0dp" />

        <!-- スペーサー（残り領域を埋める） -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- ソートボタン + バッジコンテナ（右端固定） -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp">

            <!-- ソートボタン -->
            <ImageButton
                android:id="@+id/sortButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_sort"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/keyboard_sort_label"
                android:scaleType="center"
                android:padding="8dp" />

            <!-- ソートバッジ（デフォルト以外の時に表示） -->
            <View
                android:id="@+id/sortBadge"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/sort_badge_background"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- スニペット一覧とEmptyビューのコンテナ（固定高さ：親の高さ360dp - padding 16dp - filter 44dp - marginTop 8dp = 292dp） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="292dp"
        android:layout_marginTop="8dp">

        <!-- スニペット一覧 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/snippetRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- 空の状態表示 -->
        <TextView
            android:id="@+id/emptyStateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/snippet_empty"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>

    <!-- 詳細ビュー（全画面表示、初期状態は非表示） -->
    <include layout="@layout/snippet_detail_view" />

</FrameLayout>
