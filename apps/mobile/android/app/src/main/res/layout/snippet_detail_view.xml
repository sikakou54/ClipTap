<?xml version="1.0" encoding="utf-8"?>
<!-- スニペット詳細画面レイアウト（iOS版と同じ構造） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailView"
    android:layout_width="match_parent"
    android:layout_height="360dp"
    android:minHeight="360dp"
    android:maxHeight="360dp"
    android:visibility="gone">

    <!-- スクロール可能なコンテンツエリア -->
    <ScrollView
        android:id="@+id/detailScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:paddingBottom="112dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- タイトル行（copyWithTitleがtrueの場合のみ表示） -->
            <LinearLayout
                android:id="@+id/titleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <!-- タイトル -->
                <TextView
                    android:id="@+id/detailTitleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <!-- タイトル挿入ボタン（タイトルのみを挿入し、詳細画面は開いたまま） -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/insertTitleButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:backgroundTint="@color/keyboardAccent"
                    android:tint="@color/keyboardOnAccent"
                    android:contentDescription="@string/accessibility_insert_title_button"
                    app:fabCustomSize="44dp"
                    app:fabSize="mini"
                    app:maxImageSize="20dp"
                    app:elevation="0dp"
                    app:pressedTranslationZ="0dp"
                    app:borderWidth="0dp" />

            </LinearLayout>

            <!-- タイトルと本文の区切り線（copyWithTitleがtrueの場合のみ表示） -->
            <View
                android:id="@+id/titleSeparator"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:background="@color/keyboardSeparator"
                android:visibility="gone" />

            <!-- 内容 -->
            <TextView
                android:id="@+id/detailContentLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary" />

        </LinearLayout>

    </ScrollView>

    <!-- ボタンエリア（画面下部に固定、ScrollViewの上に重ねて表示） -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="40dp"
        android:background="@android:color/transparent">

        <!-- 閉じるボタン -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/closeButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:backgroundTint="@color/keyboardSecondaryButtonBackground"
            android:tint="@color/keyboardSecondaryButtonIcon"
            app:fabCustomSize="56dp"
            app:fabSize="normal"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            app:borderWidth="0dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <!-- 改行挿入ボタン（閉じるボタンと挿入ボタンの間） -->
        <!-- タイトル挿入・本文挿入のどちらも改行を付けないため、
             同じ入力欄へ「タイトル → 改行 → 本文」と入れる用途で使う。
             主要な操作を挿入ボタンに保つため、閉じるボタンと同じ副次配色にする -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/insertNewlineButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_return"
            android:backgroundTint="@color/keyboardSecondaryButtonBackground"
            android:tint="@color/keyboardSecondaryButtonIcon"
            android:contentDescription="@string/accessibility_insert_newline_button"
            app:fabCustomSize="56dp"
            app:fabSize="normal"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            app:borderWidth="0dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <!-- コピーボタン -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/copyButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_menu_send"
            android:backgroundTint="@color/keyboardAccent"
            android:tint="@color/keyboardOnAccent"
            app:fabCustomSize="56dp"
            app:fabSize="normal"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            app:borderWidth="0dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

</FrameLayout>
