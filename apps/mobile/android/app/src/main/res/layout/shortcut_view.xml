<?xml version="1.0" encoding="utf-8"?>
<!-- ショートカット画面レイアウト（keyboard_view.xmlの一覧エリアへincludeされる）

     【親の高さに合わせる理由】
     keyboard_view.xmlの一覧エリア（listContainer、292dp）の中で定型文一覧と入れ替えて表示するため、
     高さを固定せずmatch_parentにして、一覧エリアと同じ大きさに収まるようにする。
     こうすることで切り替えても行の位置が動かない。

     【全画面ではなくなった理由】
     以前は詳細画面と同じ全画面のビューだったが、表示切替がフィルター行のトグルになったため、
     ショートカットを表示している間もフィルター行（環境チップとトグル）が見えている必要がある。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shortcutView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- ヘッダー（戻るボタン + ショートカット名）

         【値一覧のときだけ表示する理由】
         ショートカット一覧（1階層目）では、上にフィルター行があり、トグルの見た目でも
         ショートカット表示中と分かるため、見出しをもう1行置くと一覧の領域を44dp削るだけになる。
         値一覧（2階層目）では「どのショートカットの値か」と「1階層目へ戻る導線」が要るため表示する。

         【定型文一覧と同じ44dpにする理由】
         フィルター行と同じ高さにして、階層を移動しても行の高さの印象を揃える。 -->
    <LinearLayout
        android:id="@+id/shortcutHeader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <!-- 戻るボタン（ショートカット一覧へ戻る） -->
        <ImageButton
            android:id="@+id/shortcutBackButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_chevron_left"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/accessibility_back_button"
            android:scaleType="fitCenter"
            android:padding="6dp" />

        <!-- タイトル（選択中のショートカット名） -->
        <TextView
            android:id="@+id/shortcutTitleLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- 一覧とEmptyビューのコンテナ
         高さを重み（weight=1）で決める理由: ヘッダーの有無で使える高さが変わるため、
         dpで書くと畳んだときに一覧の下に44dpの空きが残ってしまう -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ショートカット一覧／値一覧（アダプターを差し替えて共用する） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shortcutRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- 空の状態表示（ショートカットが0件のとき）
             案内は「ありません」だけでは次に何をすればよいか分からないため、
             メインアプリで作成する旨を添える（iOS版の空状態と同じ2行構成） -->
        <LinearLayout
            android:id="@+id/shortcutEmptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shortcut_empty"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/shortcut_empty_hint"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
