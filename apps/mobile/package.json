{
  "name": "@cliptap/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx --prefix ../.. expo start",
    "android": "npx --prefix ../.. expo run:android",
    "ios": "npx --prefix ../.. expo run:ios",
    "web": "expo start --web",
    "prebuild": "npx --prefix ../.. expo prebuild",
    "pod-install": "cd ios && pod install",
    "claude": "claude --dangerously-skip-permissions",
    "clean": "rm -fr node_modules && rm -fr package-lock.json && npm install && npx expo prebuild --clean",
    "sync-legal": "mkdir -p assets/web && cp ../web/public/terms.html assets/web/ && cp ../web/public/privacy.html assets/web/",
    "build": "npm run sync-legal && eas build --profile production",
    "preview": "npm run sync-legal && eas build --profile preview",
    "xcode": "open ios/ClipTap.xcworkspace",
    "credentials:android": "eas credentials -p android",
    "credentials:ios": "eas credentials -p ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@cliptap/shared": "*",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/app": "^23.5.0",
    "@react-native-firebase/auth": "^23.5.0",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-picker/picker": "2.11.1",
    "@shopify/flash-list": "2.0.2",
    "dayjs": "^1.11.19",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.0",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "expo-updates": "~29.0.19",
    "i18next": "^25.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.7.3",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "^15.8.3",
    "react-native-purchases": "^9.6.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@eslint/js": "^9.39.1",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.48.1"
  },
  "private": true
}
