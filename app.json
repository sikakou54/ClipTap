{
  "expo": {
    "name": "ClipTap",
    "slug": "cliptap",
    "version": "1.0.3",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#1F2937",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sikakou.cliptap",
      "buildNumber": "28",
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "package": "com.sikakou.cliptap",
      "versionCode": 6,
      "screenOrientation": "portrait"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "cliptap",
    "owner": "sikakou",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client",
      "expo-splash-screen",
      "expo-localization",
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-tracking-transparency",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5616727577619398~4455954633",
          "iosAppId": "ca-app-pub-5616727577619398~8993844331",
          "userTrackingPermission": "関連性の高い広告を表示するためにIDをトラッキングいたします。"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/[your-project-id]"
    },
    "extra": {
      "eas": {
        "projectId": "167bab11-42f6-4180-8d97-7cec4b38dc7f"
      },
      "router": {}
    },
    "locales": {
      "en": "./english.json",
      "ja": "./japanese.json"
    }
  }
}
