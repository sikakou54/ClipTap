# full-test スキルのプロジェクト設定
#
# ここを書き換えれば、テスト仕様書・実行結果・不具合管理台帳の保存先を変更できる。
# パスはリポジトリルートからの相対パスとして解釈する。

# ---- 成果物の保存先 ----
TEST_DOC_DIR="docs/test"                    # テスト仕様書・パターン網羅表・画面/ルート台帳
ISSUES_FILE="docs/test/issues.md"           # 不具合管理台帳（Markdown）
RESULTS_DIR="docs/test/results"             # 実行ごとの結果と証跡

# ---- 対象アプリ ----
TARGET_PLATFORM="ios"                       # 現在の自動実行対象。android は未対応（手動チェック扱い）
BUNDLE_ID=""                                # 空なら apps/mobile/app.json から読み取る
APP_GROUP="group.com.sikakou.cliptap"       # 共有DBの置き場所（iOS）
DB_FILE_NAME="cliptap.db"

# ---- 実行の既定値（ミリ秒） ----
STEP_INTERVAL_MS=600                        # 各ステップ後の待ち。連続タップによる誤作動を避ける
DEFAULT_WAIT_MS=6000                        # WAIT_FOR / アサーションの既定タイムアウト
LAUNCH_WAIT_MS=12000                        # 起動完了待ちの上限。実際は準備完了を検知して先へ進む

# ---- 操作の安全域（画面高に対する比率） ----
# 画面内にあっても、下端は広告バナー、上端はステータスバーに覆われる。
# AXの座標は「覆われている」ことを教えてくれないため、比率で除外する。
# 無料プランのバナーが入る下端は特に重要で、ここを0にすると
# 一覧の末尾の要素をタップしたつもりで広告を押すことになる。
SAFE_TOP_RATIO=0.07
SAFE_BOTTOM_RATIO=0.14

# ---- 危険な操作の明示的な許可 ----
# オフライン状態のテストはホストのWi-Fiを切る。
# ClipTapはオフライン動作が最上位の要件なので、1件だけ許可している。
# ランナーは終了時（異常終了・中断を含む）に必ずWi-Fiを戻す。
ALLOW_NETWORK_TOGGLE=1
WIFI_DEVICE="en0"
